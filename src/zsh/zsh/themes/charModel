# CharModel zsh theme
# dotfiles v1.3.1
# Date: 2026-03-19

# git status is computed in precmd (once per prompt) to avoid blocking on every keypress
_GIT_INFO=""

function _update_git_info() {
    local branch
    branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null)
    if [[ -n $branch ]]; then
        if ! git diff --quiet 2>/dev/null || ! git diff --cached --quiet 2>/dev/null; then
            # * indicates a dirty working tree
            _GIT_INFO=" ($branch*)"
        else
            _GIT_INFO=" ($branch)"
        fi
    else
        _GIT_INFO=""
    fi
}

autoload -Uz add-zsh-hook
add-zsh-hook precmd _update_git_info

setopt prompt_subst

# SSH indicator — computed once at load time since it never changes mid-session
if [[ -n "${SSH_CLIENT:-}" || -n "${SSH_TTY:-}" ]]; then
    _SSH_INDICATOR="%F{#eb6f92}(ssh)%f "
else
    _SSH_INDICATOR=""
fi

# teal in tmux (username already in the status bar), purple in standalone terminal
if [[ -n $TMUX ]]; then
    PROMPT='${_SSH_INDICATOR}[%F{#9ccfd8}%~%f]${_GIT_INFO} » '
else
    PROMPT='${_SSH_INDICATOR}[%F{#907aa9}%n%f: %~]${_GIT_INFO} » '
fi

# emacs line-editing mode (ctrl+a/e for line start/end)
bindkey -e
# escape in the completion menu cancels without selecting
bindkey -M menuselect '^[' undo
# / selects the entry & drills into the next path component
bindkey -M menuselect '/' accept-and-infer-next-history
