# --- Appearance ---
font-family = "JetBrains Mono"
font-size = 16

# --- Window size ---
window-width = 150
window-height = 40

# --- Character spacing ---
adjust-cell-width = 0
adjust-cell-height = 0

# --- Terminal behavior ---
shell-integration = zsh
shell-integration-features = sudo,title

# --- Theme ---
theme = "knew-pines"
background-blur = true
background-blur-radius = 18
background-opacity = 0.95

# --- Padding/Margins ---
window-padding-x = 25, 25
window-padding-y = 15, 15
window-padding-balance = true

# --- Cursor ---
cursor-style = block
cursor-style-blink = true

# Quick terminal toggle
# keybind = global:ctrl+grave_accent=toggle_quick_terminal
