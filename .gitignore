# Rust build artifacts
/target/

# developer mode marker — create this file to disable update prompts
.developer

# user settings — not committed (theme, update prefs)
/.settings

# editors / OS junk
.DS_Store
**/.DS_Store
# macOS AppleDouble / resource-fork files
._*
**/._*

# python (legacy)
**/__pycache__

# ai
CLAUDE.md
**/CLAUDE.md

# logs
*.log

# mirrored at deploy time from the canonical root copies
site/install.sh
site/CHANGELOG.md

# stray build output — site/ is published wholesale by deploy-site.yml
site/target/
