# syntax=docker/dockerfile:1
# ── dots interactive test container (SSH access) ──────────────────────────────
# Build:  podman build --build-arg BASE=fedora -t dots-dev:fedora   -f test-env/Containerfile.interactive .
#         podman build --build-arg BASE=ubuntu -t dots-dev:ubuntu   -f test-env/Containerfile.interactive .
# Run:    podman run -d --replace --name dots-dev \
#           -p 2222:22 \
#           -v "$PWD:/home/testuser/dots:Z" \
#           dots-dev:fedora
# SSH:    ssh testuser@localhost -p 2222  (password: dots)

ARG BASE=fedora

# ── fedora ─────────────────────────────────────────────────────────────────────
FROM fedora:latest AS base-fedora
RUN dnf install -y rust cargo clippy rustfmt git which openssh-server sudo zsh dbus-devel pkgconf-pkg-config && \
    dnf clean all

# ── ubuntu ─────────────────────────────────────────────────────────────────────
FROM ubuntu:24.04 AS base-ubuntu
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        curl build-essential pkg-config libssl-dev libdbus-1-dev git which \
        openssh-server sudo zsh && \
    apt-get clean
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --default-toolchain stable
ENV PATH="/root/.cargo/bin:${PATH}"

# ── select base ────────────────────────────────────────────────────────────────
FROM base-${BASE}

RUN if command -v rustup 2>/dev/null; then \
        rustup component add clippy rustfmt; \
    fi

# create testuser with password 'dots'
RUN useradd -m -s /bin/zsh testuser && \
    echo 'testuser:dots' | chpasswd && \
    echo 'testuser ALL=(ALL) NOPASSWD: ALL' >> /etc/sudoers

# set up SSH (only ed25519 key — fast, no entropy waiting)
RUN ssh-keygen -t ed25519 -f /etc/ssh/ssh_host_ed25519_key -N "" && \
    mkdir -p /run/sshd && \
    sed -i 's/#PasswordAuthentication yes/PasswordAuthentication yes/' /etc/ssh/sshd_config && \
    sed -i 's/#PermitEmptyPasswords no/PermitEmptyPasswords no/' /etc/ssh/sshd_config && \
    echo 'UsePAM no' >> /etc/ssh/sshd_config

# use zsh for root too
RUN chsh -s /bin/zsh root

COPY --chown=testuser:testuser \
    dots-rs/Cargo.toml \
    dots-rs/src \
    dots-rs/tests \
    setup.sh \
    uninstall.sh \
    /home/testuser/dots/

EXPOSE 22
CMD ["/usr/sbin/sshd", "-D", "-o", "ListenAddress=0.0.0.0"]
